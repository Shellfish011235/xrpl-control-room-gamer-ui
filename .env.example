# XRPL Control Room - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ==================== XAMAN (XUMM) WALLET — REQUIRED FOR REAL SIGNING ====================
# 1. Go to https://apps.xumm.dev and create an app
# 2. Copy your API Key (browser only needs the Key; Secret is for backend)
# 3. Paste below and restart the dev server (npm run dev)
# Without this, the app runs in Demo Mode (no real transactions)

VITE_XAMAN_API_KEY=your-api-key-here
# VITE_XAMAN_API_SECRET=optional-backend-only

# ==================== PROXY SERVER ====================
# The proxy server port (default: 3001)
PROXY_PORT=3001

# ==================== OPTIONAL: PRICE FEEDS ====================
# CoinGecko API (free tier works, but rate limited)
# VITE_COINGECKO_API_KEY=your-coingecko-api-key

# ==================== OPTIONAL: ANALYTICS ====================
# VITE_ANALYTICS_ID=your-analytics-id

# ==================== OPENCLAW XRPL INTEGRATION ====================
# Your XRPL wallet address to receive OpenClaw fees (3%)
VITE_OPENCLAW_FEE_WALLET=your-xrpl-wallet-address-here
# Platform fee is OFF by default (compliant). Set to false ONLY after legal sign-off (see docs/COMPLIANCE-CHECKLIST.md)
# VITE_OPENCLAW_PLATFORM_FEE_DISABLED=false

# ==================== AGENT ECONOMY ====================
# Wallet that receives paid action payments (Power Mode Unlock, etc.). Must be an XRPL address you control.
VITE_AGENT_SERVICE_WALLET=your-xrpl-service-wallet-address-here

# ==================== BRIDGES / EVM (Phase 3+) ====================
# Mainnet toggle (default: testnet). When set, UI allows mainnet txs with warnings.
# VITE_XRPL_NETWORK=mainnet
# EVM RPC for XRPL Sidechain (docs.xrplevm.org)
# VITE_EVM_RPC_URL=https://your-evm-rpc-url
# Axelar / bridge APIs (optional for Cross-Chain Nexus)
# VITE_AXELAR_API_URL=https://api.axelarscan.io
