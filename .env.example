# XRPL Control Room - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git — it is gitignored.

# === SECURITY: VITE_ variables and private endpoints ===
# Anything prefixed with VITE_ is exposed in the *built* browser JavaScript bundle. Anyone
# can read it in DevTools or by downloading your site's JS. Do not put **secret** API keys
# (except keys intended for the browser) or private LAN node URLs in Vite env for a
# *public* deployment. For a private rippled, use a server-side proxy and point VITE_*
# at that proxy's public HTTPS URL only.
#
# Default XRPL public endpoints (when the vars below are unset) are hardcoded in
# src/config/xrplPublicEndpoints.ts — you do not need to duplicate them in .env unless
# you are overriding. Never paste real internal IPs into files that you commit to Git.

# ==================== XAMAN (XUMM) WALLET — REQUIRED FOR REAL SIGNING ====================
# 1. Go to https://apps.xumm.dev and create an app
# 2. Copy your API Key (browser only needs the Key; Secret is for backend)
# 3. Paste below and restart the dev server (npm run dev)
# Without this, the app runs in Demo Mode (no real transactions)

VITE_XAMAN_API_KEY=your-api-key-here
# VITE_XAMAN_API_SECRET=optional-backend-only

# ==================== PROXY SERVER ====================
# The proxy server port (default: 3001)
PROXY_PORT=3001

# ==================== XRPL — JSON-RPC + WEBSOCKET (optional override) ====================
# Leave UNSET to use the built-in public mainnet list (see xrplPublicEndpoints).
# If you set these, do so only in a local, never-committed .env. Do not hardcode
# a LAN address here for a repo that is pushed to GitHub.
#
# VITE_XRPL_RPC_URL=<your-https-rpc-endpoint>
# VITE_XRPL_WS_URL=<your-wss-endpoint>
# Optional: lock to a single pair (no rotation) — private builds only, local .env
# VITE_XRPL_PRIVATE_MODE=1
# Optional: HTTP(S) JSON-RPC proxy base (for production, use your own backend URL)
# VITE_XRPL_PROXY_URL=<your-public-https-proxy-base>

# ==================== OPTIONAL: PRICE FEEDS ====================
# VITE_COINGECKO_API_KEY=your-coingecko-api-key

# ==================== OPTIONAL: ANALYTICS ====================
# VITE_ANALYTICS_ID=your-analytics-id

# ==================== FEYNMAN ENSEMBLE VERIFIER (Phase 1 C2V) ====================
# VITE_ENSEMBLE_VERIFIER_URL=<your-scorer-endpoint>

# ==================== BUILDER AGENT (OPEN CLAW) — IN-APP AI ====================
# VITE_AI_API_URL=<your-app>/api/ai
# VITE_AI_API_KEY=

# ==================== OPENCLAW XRPL INTEGRATION ====================
# This project does not collect any platform fees or royalties. OpenClaw payments go to recipients and optional skill creators only.

# ==================== AGENT ECONOMY ====================
VITE_AGENT_SERVICE_WALLET=your-xrpl-service-wallet-address-here

# ==================== BRIDGES / EVM (Phase 3+) ====================
# VITE_XRPL_NETWORK=mainnet
# VITE_EVM_RPC_URL=<your-evm-rpc>
# VITE_AXELAR_API_URL=https://api.axelarscan.io
